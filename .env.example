# Gemini API (required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Looker 4.0 API (optional - mock data used if not set)
LOOKER_BASE_URL=https://your-instance.looker.com
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
LOOKER_VERIFY_SSL=true

# Or use Looker SDK env vars (they take precedence for looker_sdk):
# LOOKERSDK_BASE_URL=
# LOOKERSDK_CLIENT_ID=
# LOOKERSDK_CLIENT_SECRET=

# Redis (for local event queue / Celery)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry (optional)
OTLP_ENDPOINT=
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=nl2sql-agent-pipeline
TRACE_LEVEL=info
